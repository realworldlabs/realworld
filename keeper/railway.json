{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile --filter @rwa/keeper...",
    "watchPatterns": ["keeper/**", "packages/abi/**"]
  },
  "deploy": {
    "startCommand": "cd keeper && node src/main.ts",
    "restartPolicyType": "ALWAYS"
  }
}
