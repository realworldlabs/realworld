{
  "name": "@rwa/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "once": "node --env-file-if-exists=.env src/main.ts --once",
    "probe": "node --env-file-if-exists=.env src/probe.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rwa/abi": "workspace:*",
    "viem": "^2.37.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
