# Robinhood Chain RPC
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Keeper hot wallet (must be AssetRegistry.keeper and a BuybackVault operator)
KEEPER_PRIVATE_KEY=0x...
REGISTRY=0x...
PRICE_WALL=0x...
# Optional launchpad jobs
FACTORY=0x...
BUYBACK_VAULT=0x...
# Tuning
INTERVAL_SEC=300
DEADBAND_TICKS=25
BUYBACK_MIN_BUDGET=1000000
# Audit trail: Pinata JWT pins to IPFS, otherwise JSON files in AUDIT_DIR
AUDIT_DIR=audit
PINATA_JWT=
# Slack/Discord webhook for warnings and errors
ALERT_WEBHOOK=
# Source credentials
BLS_API_KEY=
PRICECHARTING_TOKEN=
