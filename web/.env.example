# Indexer REST API (indexer/)
NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:42069
# JSON-RPC used by wallets and reads
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Contract addresses: path to a deployments JSON (read at build time) or the JSON itself in NEXT_PUBLIC_DEPLOYMENTS
DEPLOYMENTS_FILE=../contracts/deployments/mainnet.json
# WalletConnect Cloud project id (optional; enables WalletConnect wallets)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Local anvil devnet only: exposes the unlocked dev account as a wallet
NEXT_PUBLIC_DEVNET=false
